# DB2 z/OS Connection Settings
# These settings are required to connect to the PeopleSoft DB2 database
DB2_DATABASE=your_db
DB2_HOSTNAME=mainframe.example.com
DB2_PORT=446
DB2_UID=your_user
DB2_PWD=your_password

# PostgreSQL Connection Settings
# Target database where PeopleSoft data will be migrated
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ps82_archive
PG_USER=postgres
PG_PASSWORD=your_password

# Migration Settings
# Control parallelism bounds (2-20 workers recommended)
MIN_WORKERS=2
MAX_WORKERS=20

# Chunk size for large table extraction (rows per chunk)
CHUNK_SIZE=500000

# Directory Paths
# Staging directory for intermediate CSV files
STAGING_DIR=d:\Development\db2postgres\data\staging

# Checkpoint directory for restart capability
CHECKPOINT_DIR=d:\Development\db2postgres\data\checkpoints

# Log directory
LOG_DIR=d:\Development\db2postgres\logs

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json (for production) or console (for development)
LOG_FORMAT=console
